# Production: the live site. Copy to .env in the repo root (git ignores it) and fill in. docs/hosting.md explains each.
PUBLIC_URL=https://payledger.example.com
COOKIE_SECURE=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_WRITES_PER_MINUTE=120
# Real email (Gmail app password, Brevo…): see .env.example
# SMTP_HOST= SMTP_PORT= SMTP_USERNAME= SMTP_PASSWORD= SMTP_AUTH=true SMTP_STARTTLS=true MAIL_FROM=
# Auto-capture by email (Cloudflare Email Routing + deploy/cloudflare/email-worker.js)
# CAPTURE_DOMAIN=in.example.com
# INBOUND_SECRET=
# "Continue with Google"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
