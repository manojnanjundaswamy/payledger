# Staging: a second, independent stack on the same machine (its own databases, Keycloak, Kafka and ports), for
# testing before production. Local only: http://localhost:5273 (demo@payledger.local / demo-password).
# scripts/env.sh staging deploy   builds the develop branch and starts it; scripts/env.sh staging down stops it.
# Not secret: it's the local defaults with other ports. Copy to .env.staging to change anything (git ignores that).
WEB_PORT=5273
GATEWAY_PORT=8100
GATEWAY_MANAGEMENT_PORT=8101
CORE_PORT=8160
CORE_MANAGEMENT_PORT=8161
LEDGER_PORT=8380
LEDGER_MANAGEMENT_PORT=8381
NOTIFICATION_PORT=8190
NOTIFICATION_MANAGEMENT_PORT=8191
KEYCLOAK_PORT=8280
MAILPIT_PORT=8125
REDIS_PORT=6479
KAFKA_PORT=9192
KAFKA_UI_PORT=8185
CORE_DB_PORT=5534
LEDGER_DB_PORT=5532
NOTIFICATION_DB_PORT=5533
# Browser tests sign everyone in as the demo user: allow them plenty of calls.
RATE_LIMIT_PER_MINUTE=3000
RATE_LIMIT_WRITES_PER_MINUTE=600
