# Copy to .env on the server (never commit .env).

# Public hostname pointing at the VM, e.g. a free DuckDNS name: payledger-yourname.duckdns.org
DOMAIN=payledger.example.com

# Image built and pushed by GitHub Actions (lowercase owner name).
LEDGER_IMAGE=ghcr.io/your-github-username/payledger/ledger-service:latest

POSTGRES_DB=ledger
POSTGRES_USER=ledger
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# Comma-separated, each >= 32 chars. Generate with: openssl rand -hex 32
API_KEYS=change-me-to-a-long-random-value-0123456789
