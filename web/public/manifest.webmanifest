{
  "name": "PayLedger",
  "short_name": "PayLedger",
  "description": "Budgets, households and splitting, built for India.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#111111",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/capture",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text"
    }
  },
  "shortcuts": [
    {
      "name": "Add expense",
      "short_name": "Expense",
      "description": "Record money spent",
      "url": "/transactions?add=EXPENSE",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add income",
      "short_name": "Income",
      "description": "Record money received",
      "url": "/transactions?add=INCOME",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Paste bank SMS",
      "short_name": "Paste SMS",
      "description": "Read bank alerts into To review",
      "url": "/capture?method=paste",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Split a bill",
      "short_name": "Split",
      "description": "Add a shared expense",
      "url": "/groups",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}