# Copy to .env (git ignores it) and fill in, then: docker compose --profile web up -d && scripts/keycloak-sync.sh
# Without these, every email goes to Mailpit (http://localhost:8025) and never leaves your laptop.

# ---- Real email (docs/notifications.md) ----
# Gmail, free, about 500 a day, good for trying things out: turn on 2-step verification, create an app password
# (Google account > Security > App passwords), then:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=the-16-letter-app-password
#   SMTP_AUTH=true
#   SMTP_STARTTLS=true
#   MAIL_FROM=you@gmail.com
#
# Brevo (free 300 a day) or Amazon SES (about $0.10 per 1,000) for real users: the same six settings, from
# their SMTP page, with MAIL_FROM on a domain you've verified with them.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=
SMTP_STARTTLS=
MAIL_FROM=

# ---- Hosting on your own address (docs/hosting.md) ----
# The address people open, e.g. through a Cloudflare Tunnel to http://localhost:5173. Sign-in pages are then served
# through it too. After changing it: docker compose --profile web up -d && scripts/keycloak-sync.sh
#   PUBLIC_URL=https://payledger.example.com
#   COOKIE_SECURE=true
#   RATE_LIMIT_PER_MINUTE=600
#   RATE_LIMIT_WRITES_PER_MINUTE=120
