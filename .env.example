# Copy to .env (git ignores it) and fill in, then: docker compose --profile web up -d && scripts/keycloak-sync.sh
# Without these, every email goes to Mailpit (http://localhost:8025) and never leaves your laptop.

# ---- Real email (docs/notifications.md) ----
# Gmail, free, about 500 a day, good for trying things out: turn on 2-step verification, create an app password
# (Google account > Security > App passwords), then:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=the-16-letter-app-password
#   SMTP_AUTH=true
#   SMTP_STARTTLS=true
#   MAIL_FROM=you@gmail.com
#
# Brevo (free 300 a day) or Amazon SES (about $0.10 per 1,000) for real users: the same six settings, from
# their SMTP page, with MAIL_FROM on a domain you've verified with them.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=
SMTP_STARTTLS=
MAIL_FROM=

# ---- Hosting on your own address (docs/hosting.md) ----
# The address people open, e.g. through a Cloudflare Tunnel to http://localhost:5173. Sign-in pages are then served
# through it too. After changing it: docker compose --profile web up -d && scripts/keycloak-sync.sh
#   PUBLIC_URL=https://payledger.example.com
#   COOKIE_SECURE=true
#   RATE_LIMIT_PER_MINUTE=600
#   RATE_LIMIT_WRITES_PER_MINUTE=120

# ---- "Continue with Google" (docs/hosting.md) ----
# From Google Cloud Console > Google Auth Platform > Clients (a Web application client). Then: scripts/keycloak-sync.sh
#   GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
#   GOOGLE_CLIENT_SECRET=GOCSPX-...

# AI reading: quick add by voice/text and a second opinion on bank alerts (docs/ai.md). Leave AI_API_KEY empty to keep it off.
# Claude:      AI_PROVIDER=anthropic   AI_MODEL=claude-haiku-5-5
# OpenRouter:  AI_PROVIDER=openrouter  AI_MODEL=anthropic/claude-haiku-5-5 (or any model it lists)
# Others:      AI_PROVIDER=openai-compatible AI_BASE_URL=https://.../v1 AI_MODEL=...
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
# US$ per million tokens, for the cost log only
AI_PRICE_INPUT=1.0
AI_PRICE_OUTPUT=5.0
# Speech to text for Firefox and other browsers without their own (OpenAI or Groq key). Chrome, Edge, Safari don't need it.
STT_API_KEY=
