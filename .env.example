# Local overrides for docker-compose.yml. Copy to .env (git-ignored) and change what you need.
# Every value has a working default, so .env is optional.

# Host ports (change if something on your machine already uses them)
LEDGER_DB_PORT=5432
NOTIFICATION_DB_PORT=5433
CORE_DB_PORT=5434
KEYCLOAK_PORT=8180
MAILPIT_PORT=8025
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_UI_PORT=8085
GATEWAY_PORT=8000
GATEWAY_MANAGEMENT_PORT=8001
CORE_PORT=8060
CORE_MANAGEMENT_PORT=8061
LEDGER_PORT=8080
LEDGER_MANAGEMENT_PORT=8081
NOTIFICATION_PORT=8090
NOTIFICATION_MANAGEMENT_PORT=8091

# Event streaming
LEDGER_EVENTS_TOPIC=ledger.entries.v2
LEDGER_EVENTS_PARTITIONS=3
# false = the ledger runs without publishing; events wait in its outbox_events table
OUTBOX_RELAY_ENABLED=true

# Where the web app runs; the gateway sends users back here after login and logout
FRONTEND_URL=http://localhost:5173
