# Files that run inside Linux containers or bash must keep LF line endings,
# even on a Windows checkout with core.autocrlf=true.
* text=auto
*.sh text eol=lf
mvnw text eol=lf
*.cmd text eol=crlf
Dockerfile text eol=lf
*.conf text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.properties text eol=lf
